# RustFS / S3-compatible object storage
RUSTFS_ENDPOINT=https://rusts.zeabur.app
RUSTFS_BUCKET=wzsj-media
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Optional: RustFS management API key (not used by the S3 client)
RUSTFS_API_KEY=

# 管理员（站长）账号：唯一一个，不可注册第二个
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 数据目录：Zeabur 挂卷到 /data 时自动使用；本地默认 .data/
# DATA_DIR=/data
