{
  "name": "wzsj-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "亡者世界 · 生存图鉴（Hono + TypeScript）",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:sw": "tsx scripts/build-sw.ts",
    "build:precompress": "tsx scripts/precompress.ts",
    "build": "npm run build:client && npm run build:server && npm run build:sw && npm run build:precompress",
    "start": "node dist/server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:assets": "tsx scripts/check-assets.ts",
    "verify": "npm run build && npm run check && npm run check:assets",
    "gen:recipes": "tsx scripts/gen-recipes.ts",
    "gen:tiers": "tsx scripts/gen-tiers.ts",
    "gen:compat": "tsx scripts/gen-compat.ts",
    "gen:atlas": "tsx scripts/gen-atlas-extra.ts",
    "gen:ammo-icons": "tsx scripts/gen-ammo-icons.ts",
    "verify:recipes": "tsx scripts/verify-recipes.ts",
    "verify:tiers": "tsx scripts/verify-tiers.ts",
    "verify:gunsmith": "tsx scripts/verify-gunsmith.ts",
    "verify:compat": "tsx scripts/verify-compat.ts",
    "gen:monsters": "tsx scripts/gen-monster-difficulty.ts",
    "verify:monsters": "tsx scripts/verify-monster-difficulty.ts",
    "gen:hordebuildings": "tsx scripts/gen-horde-buildings.ts",
    "verify:hordebuildings": "tsx scripts/verify-horde-buildings.ts",
    "gen:spawntiers": "tsx scripts/gen-monster-spawn-tiers.ts",
    "verify:spawntiers": "tsx scripts/verify-monster-spawn-tiers.ts",
    "verify:monsterguide": "tsx scripts/verify-monster-guide.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.10.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  }
}