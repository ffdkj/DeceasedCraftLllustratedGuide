{
  "name": "wzsj-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "亡者世界 · 生存图鉴（Hono + TypeScript）",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:sw": "tsx scripts/build-sw.ts",
    "build:precompress": "tsx scripts/precompress.ts",
    "build": "npm run build:client && npm run build:server && npm run build:sw && npm run build:precompress",
    "start": "node dist/server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:assets": "tsx scripts/check-assets.ts",
    "verify": "npm run build && npm run check && npm run check:assets"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  }
}
